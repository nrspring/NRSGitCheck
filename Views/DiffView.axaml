<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NRSGitCheck.ViewModels"
             xmlns:conv="using:NRSGitCheck.Converters"
             xmlns:views="using:NRSGitCheck.Views"
             x:Class="NRSGitCheck.Views.DiffView"
             x:DataType="vm:DiffViewModel">

  <UserControl.Resources>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Menlo, monospace</FontFamily>

    <ItemsPanelTemplate x:Key="HorizontalPanel">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- One word-level run: highlighted background for changed words (FR-23). -->
    <DataTemplate x:Key="SegmentTemplate" x:DataType="vm:RenderSegment">
      <Border Background="{Binding Converter={x:Static conv:SegmentBrushConverter.Instance}}">
        <TextBlock Text="{Binding Text}"
                   Foreground="{Binding Converter={x:Static conv:SegmentForegroundConverter.Instance}}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="NoWrap" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Bottom padding so the floating horizontal scrollbar doesn't cover the
         last few rows on long diffs; it scrolls into view at the end. -->
    <Style Selector="ListBox.diff">
      <Setter Property="Padding" Value="0,0,0,18" />
    </Style>
    <Style Selector="ListBox.diff > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Selected lines wash under the row's own add/remove tint, so a selected
         change still reads as added or removed. -->
    <Style Selector="ListBox.diff > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSelection}" />
    </Style>
    <Style Selector="ListBox.diff > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.diff > ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSelection}" />
    </Style>
    <Style Selector="TextBlock.gutter">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <!-- Empty / binary / too-large / no-changes message -->
    <TextBlock Text="{Binding Message}"
               Opacity="0.55"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding ShowMessage}" />

    <!-- Rendered diff -->
    <Grid IsVisible="{Binding ShowDiff}" RowDefinitions="Auto,*">

      <!-- Header: filename + layout toggle + legend -->
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource AppBorder}"
              BorderThickness="0,0,0,1"
              Padding="10,7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding FilePath}" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#3328A745" CornerRadius="999" Padding="9,3" VerticalAlignment="Center">
              <TextBlock Text="added" FontSize="11" VerticalAlignment="Center" />
            </Border>
            <Border Background="#33E05252" CornerRadius="999" Padding="9,3" VerticalAlignment="Center">
              <TextBlock Text="removed" FontSize="11" VerticalAlignment="Center" />
            </Border>
            <ToggleButton Content="{Binding WholeFileToggleLabel}" IsChecked="{Binding ShowWholeFile}"
                          ToolTip.Tip="Show the entire file instead of just the changed regions" />
            <Button Content="Inline view" Command="{Binding ToggleLayoutCommand}" IsVisible="{Binding IsSideBySide}" />
            <Button Content="Side-by-side view" Command="{Binding ToggleLayoutCommand}" IsVisible="{Binding IsInline}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Inline / unified, with its change-overview strip alongside the scrollbar -->
      <Grid Grid.Row="1" ColumnDefinitions="*,10" IsVisible="{Binding IsInline}">

        <ListBox Grid.Column="0"
                 Name="InlineList"
                 SelectionMode="Multiple"
                 KeyDown="OnDiffListKeyDown"
                 Classes="diff"
                 ItemsSource="{Binding InlineRows}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCopyMenuClick" />
            </ContextMenu>
          </ListBox.ContextMenu>

          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:HunkSeparatorRow">
              <Border Background="{DynamicResource AppChrome}" Padding="10,3">
                <TextBlock Text="{Binding Header}" FontFamily="{StaticResource MonoFont}" FontSize="11" Opacity="0.6" />
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:InlineDiffRow">
              <Grid ColumnDefinitions="44,44,14,*"
                    Background="{Binding Kind, Converter={x:Static conv:DiffLineKindToBackgroundConverter.Instance}}">
                <TextBlock Grid.Column="0" Classes="gutter" Text="{Binding OldNumber}" />
                <TextBlock Grid.Column="1" Classes="gutter" Text="{Binding NewNumber}" />
                <TextBlock Grid.Column="2" Text="{Binding Marker}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                           TextAlignment="Center" Opacity="0.7" />
                <ItemsControl Grid.Column="3"
                              ItemsSource="{Binding Segments}"
                              ItemsPanel="{StaticResource HorizontalPanel}"
                              ItemTemplate="{StaticResource SegmentTemplate}" />
              </Grid>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

        <!-- Change overview: every changed region of the file, in document order,
             beside the pane's scrollbar. Clicking a tick jumps to that change. -->
        <views:ChangeMapStrip Grid.Column="1" Rows="{Binding InlineRows}" Target="{Binding #InlineList}"
                              ToolTip.Tip="Changes in this file — click to jump" />

      </Grid>

      <!-- Side-by-side: two equal-width panes, each with its own horizontal
           scrollbar; vertical scrolling is kept in sync via code-behind. -->
      <Grid Grid.Row="1" ColumnDefinitions="*,1,*" IsVisible="{Binding IsSideBySide}">

        <Grid Grid.Column="0" ColumnDefinitions="*,10">

          <ListBox Grid.Column="0"
                   Name="SideLeftList"
                   SelectionMode="Multiple"
                   KeyDown="OnDiffListKeyDown"
                   Classes="diff"
                   ItemsSource="{Binding SideRows}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCopyMenuClick" />
              </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.DataTemplates>
              <DataTemplate DataType="vm:HunkSeparatorRow">
                <Border Background="{DynamicResource AppChrome}" Padding="10,3">
                  <TextBlock Text="{Binding Header}" FontFamily="{StaticResource MonoFont}" FontSize="11" Opacity="0.6" />
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:SideDiffRow">
                <Border Background="{Binding Left, Converter={x:Static conv:SideCellBackgroundConverter.Instance}}">
                  <Grid ColumnDefinitions="44,*">
                    <TextBlock Grid.Column="0" Classes="gutter" Text="{Binding Left.Number}" />
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding Left.Segments}"
                                  ItemsPanel="{StaticResource HorizontalPanel}"
                                  ItemTemplate="{StaticResource SegmentTemplate}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>

          <views:ChangeMapStrip Grid.Column="1" Rows="{Binding SideRows}" Target="{Binding #SideLeftList}"
                                ToolTip.Tip="Changes in this file — click to jump" />

        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource AppBorder}" />

        <Grid Grid.Column="2" ColumnDefinitions="*,10">

          <ListBox Grid.Column="0"
                   Name="SideRightList"
                   SelectionMode="Multiple"
                   KeyDown="OnDiffListKeyDown"
                   Classes="diff"
                   ItemsSource="{Binding SideRows}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCopyMenuClick" />
              </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.DataTemplates>
              <DataTemplate DataType="vm:HunkSeparatorRow">
                <Border Background="{DynamicResource AppChrome}" Padding="10,3">
                  <TextBlock Text="{Binding Header}" FontFamily="{StaticResource MonoFont}" FontSize="11" Opacity="0.6" />
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:SideDiffRow">
                <Border Background="{Binding Right, Converter={x:Static conv:SideCellBackgroundConverter.Instance}}">
                  <Grid ColumnDefinitions="44,*">
                    <TextBlock Grid.Column="0" Classes="gutter" Text="{Binding Right.Number}" />
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding Right.Segments}"
                                  ItemsPanel="{StaticResource HorizontalPanel}"
                                  ItemTemplate="{StaticResource SegmentTemplate}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>

          <views:ChangeMapStrip Grid.Column="1" Rows="{Binding SideRows}" Target="{Binding #SideRightList}"
                                ToolTip.Tip="Changes in this file — click to jump" />

        </Grid>

      </Grid>

    </Grid>
  </Panel>

</UserControl>
