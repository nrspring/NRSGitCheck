<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NRSGitCheck.ViewModels"
             xmlns:models="using:NRSGitCheck.Models"
             xmlns:conv="using:NRSGitCheck.Converters"
             x:Class="NRSGitCheck.Views.RepositoriesView"
             x:DataType="vm:RepositoriesViewModel">

  <Panel>
  <DockPanel LastChildFill="True">

    <!-- Toolbar: add / refresh / bulk pull, plus what just happened. -->
    <Border DockPanel.Dock="Top"
            Classes="chrome"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <StackPanel Spacing="8">

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding AddRepositoryCommand}" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="＋" />
              <TextBlock Text="Add repository…" />
            </StackPanel>
          </Button>

          <Button Content="Refresh" Command="{Binding RefreshAllCommand}" />

          <Button Command="{Binding PullAllOnMainCommand}"
                  ToolTip.Tip="Fast-forward the integration branch in every repository that currently has main (or master) checked out. Repositories on a feature branch are skipped.">
            <TextBlock Text="Pull all on main" />
          </Button>

          <Button Content="Branch pattern…"
                  Command="{Binding EditBranchPatternCommand}"
                  ToolTip.Tip="Define the {Token} pattern new branch names are built from, and the expression that fills each token" />

          <Button Content="{Binding NewBranchSelectedLabel}"
                  Command="{Binding NewBranchForSelectedCommand}"
                  ToolTip.Tip="Create the same branch in every repository checked below" />

          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding IsBusy}"
                       Width="110" Height="4"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0" />
        </StackPanel>

        <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

        <TextBlock Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Panel>

      <!-- Empty state -->
      <StackPanel IsVisible="{Binding !HasRepositories}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" MaxWidth="460">
        <TextBlock Text="No repositories yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center"
                   Text="Add the repositories you work in and this tab will show each one's branch, whether it has uncommitted changes, and whether it has commits you haven't pushed." />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding HasRepositories}">
        <ItemsControl ItemsSource="{Binding Repositories}" Margin="16,12,16,20">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackedRepositoryViewModel">

              <Border Classes="card" Margin="0,0,0,10" Padding="16,14">

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                  <!-- Included in a bulk action (currently: creating a branch across
                       several repositories at once). Cleared automatically if the
                       repository becomes unreadable. -->
                  <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding IsValid}"
                            VerticalAlignment="Top"
                            Margin="0,2,10,0"
                            ToolTip.Tip="Include this repository the next time you create a branch across several at once" />

                  <!-- Identity -->
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <!-- Capped so a deep path trims instead of pushing the copy
                           button out of the card; the tooltip still has all of it. -->
                      <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.55"
                                 VerticalAlignment="Center"
                                 MaxWidth="560"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />

                      <!-- Copy the path. Drawn rather than set in a glyph font, so it
                           renders the same wherever the app runs. -->
                      <Button Classes="ghost"
                              Command="{Binding CopyPathCommand}"
                              Padding="4"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Copy this path to the clipboard">
                        <Canvas Width="13" Height="13">
                          <Rectangle Canvas.Left="0" Canvas.Top="0" Width="9" Height="9"
                                     RadiusX="2" RadiusY="2"
                                     Stroke="{DynamicResource AppMutedText}" StrokeThickness="1.1" />
                          <Rectangle Canvas.Left="4" Canvas.Top="4" Width="9" Height="9"
                                     RadiusX="2" RadiusY="2"
                                     Fill="{DynamicResource AppSurface}"
                                     Stroke="{DynamicResource AppMutedText}" StrokeThickness="1.1" />
                        </Canvas>
                      </Button>
                    </StackPanel>
                  </StackPanel>

                  <!-- Stop tracking. Removes the entry here only; nothing on disk is touched. -->
                  <Button Grid.Row="0" Grid.Column="2"
                          Classes="ghost"
                          Content="✕"
                          Command="{Binding RemoveCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          Padding="9,3"
                          VerticalAlignment="Top"
                          ToolTip.Tip="Remove from this list (the repository itself is left alone)" />

                  <!-- Unreadable repository: say why, and offer nothing that would fail. -->
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             Margin="0,10,0,0"
                             IsVisible="{Binding !IsValid}"
                             Text="{Binding Error}"
                             Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                             FontSize="12"
                             TextWrapping="Wrap" />

                  <!-- Branch, state, actions -->
                  <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                        Margin="0,10,0,0"
                        IsVisible="{Binding IsValid}"
                        ColumnDefinitions="Auto,*,Auto">

                    <!-- Switching branch runs a plain checkout: Git carries changes
                         over when it can, and refuses when they would be lost. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="Branch" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                      <ComboBox ItemsSource="{Binding LocalBranches}"
                                SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                PlaceholderText="{Binding CurrentBranch}"
                                IsEnabled="{Binding !IsBusy}"
                                MinWidth="190"
                                MaxDropDownHeight="360"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Check out another local branch" />
                    </StackPanel>

                    <!-- State badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                Margin="12,0" VerticalAlignment="Center">

                      <!-- The one badge that does something: it opens the commit /
                           discard menu for this repository's working tree. -->
                      <Button Classes="badge"
                              IsVisible="{Binding HasUncommittedChanges}"
                              IsEnabled="{Binding !IsBusy}"
                              ToolTip.Tip="Commit or discard the changes in this repository">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <TextBlock Text="{Binding UncommittedText}"
                                     Foreground="{DynamicResource AppWarnText}"
                                     FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Text="&#x25BE;"
                                     Foreground="{DynamicResource AppWarnText}"
                                     FontSize="10" Opacity="0.8" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Commit changes…" Command="{Binding CommitChangesCommand}" />
                            <MenuItem Header="Discard changes…" Command="{Binding DiscardChangesCommand}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>

                      <Border Classes="badge" Background="{DynamicResource AppInfoFill}"
                              IsVisible="{Binding HasUnpushedCommits}">
                        <TextBlock Text="{Binding UnpushedText}" Foreground="{DynamicResource AppInfoText}" />
                      </Border>

                      <Border Classes="badge" Background="{DynamicResource AppMutedFill}"
                              IsVisible="{Binding IsBehind}">
                        <TextBlock Text="{Binding BehindText}" Foreground="{DynamicResource AppMutedText}" />
                      </Border>

                      <TextBlock Text="clean" FontSize="11" Opacity="0.5"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsClean}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="New branch…"
                              Command="{Binding NewBranchCommand}"
                              ToolTip.Tip="Create a branch here, starting from the checked-out branch" />
                      <Button Content="{Binding SwitchToMainLabel}"
                              Command="{Binding SwitchToMainCommand}"
                              ToolTip.Tip="Check out this repository's main branch" />
                      <Button Content="{Binding PullMainLabel}"
                              Command="{Binding PullMainCommand}"
                              ToolTip.Tip="Fetch and fast-forward main. Your working tree is left alone unless main is checked out." />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>

            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>

  <!-- Create-branch dialog: one field per token in the pattern, seeded from that
       token's expression and editable before the branch is created. -->
  <Border x:DataType="vm:NewBranchViewModel"
          DataContext="{Binding NewBranch}"
          IsVisible="{Binding IsVisible}"
          Background="#99000000">
    <Border Classes="card" Padding="24" MinWidth="560" MaxWidth="680"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">

        <StackPanel Spacing="3">
          <TextBlock Text="New branch" FontSize="18" FontWeight="SemiBold" />

          <!-- One target: the familiar single-line "in X from Y". -->
          <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding !HasMultipleTargets}">
            <TextBlock Text="in" Opacity="0.6" />
            <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" />
            <TextBlock Text="from" Opacity="0.6" />
            <TextBlock Text="{Binding SourceBranch}" FontFamily="Cascadia Code,Consolas,monospace" />
          </StackPanel>

          <!-- Several targets: each can be sitting on a different branch, so list them. -->
          <StackPanel Spacing="4" IsVisible="{Binding HasMultipleTargets}" Margin="0,4,0,0">
            <TextBlock Text="in:" Opacity="0.6" />
            <ItemsControl ItemsSource="{Binding Targets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NewBranchTargetViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="10,1,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="from" Opacity="0.6" FontSize="12" />
                    <TextBlock Text="{Binding Branch}" FontSize="12"
                               FontFamily="Cascadia Code,Consolas,monospace" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- Pattern configured: one field per token. -->
        <StackPanel Spacing="10" IsVisible="{Binding HasPattern}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Pattern" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Pattern}" FontSize="12" Opacity="0.8"
                       FontFamily="Cascadia Code,Consolas,monospace" VerticalAlignment="Center" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Tokens}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BranchTokenInputViewModel">
                <Grid ColumnDefinitions="150,*" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                             Opacity="0.8" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- The token's default expression failed; the field just starts empty. -->
                    <TextBlock Text="{Binding SeedError}"
                               IsVisible="{Binding HasSeedError}"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="150,*">
            <TextBlock Grid.Column="0" Text="Branch name" Opacity="0.6" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding BranchName}" FontWeight="SemiBold"
                       FontFamily="Cascadia Code,Consolas,monospace" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
          </Grid>
        </StackPanel>

        <!-- No pattern configured: just take a name. -->
        <StackPanel Spacing="6" IsVisible="{Binding !HasPattern}">
          <TextBox Text="{Binding BranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="feature/my-change"
                   FontFamily="Cascadia Code,Consolas,monospace" />
          <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                     Text="Set up a pattern under Branch pattern to have these names filled in for you." />
        </StackPanel>

        <TextBlock Opacity="0.5" FontSize="11" TextWrapping="Wrap"
                   Text="Spaces become dashes, and characters Git will not accept in a ref are dropped. The branch starts at the checked-out commit and is checked out." />

        <TextBlock Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}" />
          <Button Content="Create branch" Command="{Binding CreateCommand}" Classes="accent" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <!-- Branch-pattern settings: the pattern, and the C# expression behind each token. -->
  <Border x:DataType="vm:BranchPatternViewModel"
          DataContext="{Binding BranchPattern}"
          IsVisible="{Binding IsVisible}"
          Background="#99000000">
    <Border Classes="card" Padding="24" MinWidth="640" MaxWidth="820"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">

        <TextBlock Text="Branch name pattern" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                   Text="Write the shape of a branch name, putting each part you fill in yourself in braces &#8212; for example nrs/{Date}-sa-{SANumber}-{description}. Every placeholder becomes a field in the New branch dialog." />

        <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="nrs/{Date}-sa-{SANumber}-{description}"
                 FontFamily="Cascadia Code,Consolas,monospace" />

        <TextBlock Text="{Binding PatternError}"
                   IsVisible="{Binding HasPatternError}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                   Text="Each field can be pre-filled by a C# expression that returns a value, such as DateTime.Now.ToString(&quot;yyyyMMdd&quot;). Leave one blank to start that field empty." />

        <ItemsControl ItemsSource="{Binding Tokens}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BranchTokenDefaultViewModel">
              <Grid ColumnDefinitions="150,*" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Top"
                           Margin="0,7,10,0" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBox Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Watermark="DateTime.Now.ToString(&quot;yyyyMMdd&quot;)"
                           FontFamily="Cascadia Code,Consolas,monospace" />

                  <!-- Compiler error, or whatever the expression threw when it ran. -->
                  <TextBlock Text="{Binding Error}"
                             IsVisible="{Binding HasError}"
                             FontSize="11"
                             Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                             TextWrapping="Wrap" />

                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPreview}">
                    <TextBlock Text="&#8594;" Opacity="0.45" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Preview}" FontSize="11" Opacity="0.7"
                               FontFamily="Cascadia Code,Consolas,monospace" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="150,*">
          <TextBlock Grid.Column="0" Text="Example" Opacity="0.6" FontSize="12"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Preview}" FontWeight="SemiBold"
                     FontFamily="Cascadia Code,Consolas,monospace" TextWrapping="Wrap" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <!-- Commit dialog: everything in the working tree is staged and committed, so the
       list below is the commit. -->
  <Border x:DataType="vm:CommitChangesViewModel"
          DataContext="{Binding Commit}"
          IsVisible="{Binding IsVisible}"
          Background="#99000000">
    <Border Classes="card" Padding="24" MinWidth="600" MaxWidth="760"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">

        <StackPanel Spacing="3">
          <TextBlock Text="Commit changes" FontSize="18" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="in" Opacity="0.6" />
            <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" />
            <TextBlock Text="on" Opacity="0.6" />
            <TextBlock Text="{Binding Branch}" FontFamily="Cascadia Code,Consolas,monospace" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" />

        <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6"
                MaxHeight="220">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,8">
              <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:WorkingTreeChange">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <Border Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                              Background="{Binding Kind, Converter={x:Static conv:ChangeKindToBrushConverter.Instance}}">
                        <TextBlock Text="{Binding Marker}" FontSize="10" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Path}" FontSize="12"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding UnlistedChangesText}"
                         IsVisible="{Binding HasUnlistedChanges}"
                         Opacity="0.55" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <StackPanel Spacing="5">
          <TextBlock Text="Commit message" Opacity="0.6" FontSize="12" />
          <TextBox Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="86"
                   MaxHeight="180"
                   Watermark="Describe what changed" />
        </StackPanel>

        <TextBlock Opacity="0.5" FontSize="11" TextWrapping="Wrap"
                   Text="Every listed path is staged and committed together. Nothing is pushed &#8212; the commit stays local until you push it yourself." />

        <TextBlock Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}" />
          <Button Content="Commit" Command="{Binding CommitCommand}" Classes="accent" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <!-- Discard confirmation. Nothing has run yet while this is on screen; it is here
       so the user sees exactly what is about to be thrown away. -->
  <Border x:DataType="vm:DiscardChangesViewModel"
          DataContext="{Binding Discard}"
          IsVisible="{Binding IsVisible}"
          Background="#99000000">
    <Border Classes="card" Padding="24" MinWidth="600" MaxWidth="760"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">

        <StackPanel Spacing="3">
          <TextBlock Text="Discard changes" FontSize="18" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="in" Opacity="0.6" />
            <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" />
            <TextBlock Text="on" Opacity="0.6" />
            <TextBlock Text="{Binding Branch}" FontFamily="Cascadia Code,Consolas,monospace" />
          </StackPanel>
        </StackPanel>

        <Border Background="{DynamicResource AppWarnFill}" CornerRadius="6" Padding="12,9">
          <StackPanel Spacing="4">
            <TextBlock Text="This cannot be undone." FontWeight="SemiBold"
                       Foreground="{DynamicResource AppWarnText}" />
            <TextBlock Text="{Binding TrackedSummary}" FontSize="12"
                       Foreground="{DynamicResource AppWarnText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6"
                MaxHeight="220">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,8">
              <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:WorkingTreeChange">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <Border Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                              Background="{Binding Kind, Converter={x:Static conv:ChangeKindToBrushConverter.Instance}}">
                        <TextBlock Text="{Binding Marker}" FontSize="10" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Path}" FontSize="12"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding UnlistedChangesText}"
                         IsVisible="{Binding HasUnlistedChanges}"
                         Opacity="0.55" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Untracked files have never been in Git, so nothing can bring them back.
             Deleting them is a separate yes, off every time this opens. -->
        <StackPanel Spacing="4" IsVisible="{Binding HasUntrackedFiles}">
          <CheckBox IsChecked="{Binding DeleteUntrackedFiles, Mode=TwoWay}"
                    Content="{Binding UntrackedSummary}" />
          <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,0"
                     Text="These files have never been committed, so there is no copy to restore them from. Ignored files &#8212; build output, local config &#8212; are left alone either way." />
        </StackPanel>

        <TextBlock Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}"
                  IsDefault="True" />
          <Button Content="Discard changes" Command="{Binding DiscardCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  </Panel>

</UserControl>
